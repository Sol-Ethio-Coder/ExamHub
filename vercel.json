{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "node_modules/pdfkit/js/data/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
